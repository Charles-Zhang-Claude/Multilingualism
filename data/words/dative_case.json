{"slug":"dative_case","word":"dative case","rank":9791,"category":"communication","pos":"noun","gloss":"case used to express direction towards an indirect object","definitions":["Case used to express direction towards an indirect object, the recipient or beneficiary of an action, and is generally indicated in English by to (when a recipient) or for (when a beneficiary) with the objective case. The direct object may be either stated or unstated where the indirect object is the beneficiary of the verbal action, but is stated where the indirect object is a recipient. If there is emphasis on the indirect object, the indirect object usually precedes the direct object and is not usually indicated with to or for; said structure is also used when neither object is being emphasized."],"translations":{"sq":[{"w":"dhanore","g":"f"}],"ar":[{"w":"حالة المفعول له","g":"f"},{"w":"حالة من حالات النصب","g":"f"}],"hy":[{"w":"տրական հոլով","r":"trakan holov"},{"w":"տրական","r":"trakan"}],"be":[{"w":"давальны склон","r":"davalʹny sklon","g":"m"},{"w":"давальны","r":"davalʹny","g":"m"}],"bs":[{"w":"dativ","g":"m"}],"bg":[{"w":"дателен падеж","r":"datelen padež","g":"m"}],"ca":[{"w":"datiu","g":"m"}],"zh-Hans":[{"w":"与格","r":"yǔgé"}],"zh-Hant":[{"w":"與格","r":"yǔgé"}],"hr":[{"w":"dativ","g":"m"}],"cs":[{"w":"dativ","g":"m"},{"w":"třetí pád","g":"m"}],"da":[{"w":"dativ","src":"ai"}],"nl":[{"w":"datief","g":"m"},{"w":"derde naamval","g":"m"},{"w":"dativus","g":"m"}],"eo":[{"w":"dativo"}],"et":[{"w":"daativ"}],"fi":[{"w":"datiivi"}],"fr":[{"w":"datif","g":"m"},{"w":"complément d'objet indirect","g":"m"},{"w":"C.O.I.","g":"m"},{"w":"troisième déclinaison"}],"gl":[{"w":"caso dativo","g":"m"}],"ka":[{"w":"მიცემითი ბრუნვა","r":"micemiti brunva"},{"w":"მიცემითი","r":"micemiti"}],"de":[{"w":"Dativ","g":"m"},{"w":"Wemfall","g":"m"},{"w":"dritter Fall","g":"m"},{"w":"Wem-Fall","g":"m"}],"el":[{"w":"δοτική πτώση","r":"dotikí ptósi","g":"f"}],"gu":[{"w":"ચતુર્થી","r":"caturthī","g":"f"}],"hu":[{"w":"r