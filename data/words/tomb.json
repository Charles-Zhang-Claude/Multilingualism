{"slug":"tomb","word":"tomb","rank":5179,"category":"things","pos":"noun","gloss":"small building or vault for the remains of the dead","definitions":["A small building, or a room within one, for the remains of the dead, with walls, a roof, and (if it is to be used for more than one corpse) a door. It may be partly or wholly in the ground (except for its entrance) in a cemetery, or it may be inside a church proper or in its crypt. Single tombs may be permanently sealed; those for families (or other groups) have doors for access whenever needed.","A pit in which the dead body of a human being is deposited.","One who keeps secrets."],"translations":{"sq":[{"w":"varr","g":"m"}],"ar":[{"w":"قبر","r":"qabr","g":"m"},{"w":"ضريح","r":"ḍarīḥ","g":"m"}],"hy":[{"w":"դամբարան","r":"dambaran"}],"az":[{"w":"məzar"},{"w":"məqbərə"}],"be":[{"w":"грабніца","r":"hrabnica","g":"f"},{"w":"магільня","r":"mahilʹnja","g":"f"}],"bn":[{"w":"কবর","r":"kobor"},{"w":"সমাধি","r":"śomadhi"}],"bs":[{"w":"grobnica","g":"f"}],"bg":[{"w":"гробница","r":"grobnica","g":"f"}],"ca":[{"w":"tomba","g":"f"}],"ny":[{"w":"manda"}],"zh-Hans":[{"w":"坟墓","r":"fénmù"},{"w":"墓葬","r":"mùzàng"},{"w":"宅兆","r":"zháizhào"}],"zh-Hant":[{"w":"墳墓","r":"fénmù"},{"w":"墓葬","r":"mùzàng"},{"w":"宅兆","r":"zháizhào"}],"hr":[{"w":"grobnica","g":"f"}],"cs":[{"w":"hrobka","g":"f"}],"da":[{"w":"grav","g":"c"},{"w":"gravkammer","g":"n"}],"nl":[{"w":"tombe","g":"mf"}],"eo":[{"w":"tombo"}],"et":[{"w":"hauakamber"}],"fi":[{"w":"hauta"},{"w":"hautakappeli"},{"w":"hautakammio"}],"fr":[{"w":"tombeau","g":"m"},{"w":"tombe","g":"f"}],"gl":[{"w":"túmulo","g":"m"},{"w":"sepulcro","g":"m"},{"w":"tumba","g":"f"}],"ka":[{"w":"საფლავი","r":"saplavi"}],"de":[{"w":"Grabmal","g":"n"},{"w":"Gruft","g":"f"}],"el":[{"w":"τάφος","r":"táfos","g":"m"},{"w":"ταφικό μνημείο","r":"tafikó mnimeío","g":"n"}],"ht":[{"w":"tonm"}],"hi":[{"w":"क़ब्र","r":"qabr","g":"f"},{"w":"समाधि","r":"samādhi"}],"hu":[{"w":"sír"},{"w":"síremlék"}],"ga":[{"w":"tuama","g":"m"}],"